<Window
    x:Class="LoginPage.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LoginPage"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    Width="800"
    Height="450"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Background="#f6f6f5">
            <Grid HorizontalAlignment="Center" Background="#f6f6f5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel>

                    <TextBlock
                        Margin="10"
                        FontSize="12"
                        FontWeight="Bold">
                        CoffeeChain
                    </TextBlock>
                    <TextBlock
                        Margin="10"
                        FontSize="12"
                        Foreground="#777">
                        Hệ thống quản lý chuỗi quán cà phê
                    </TextBlock>
                </StackPanel>
                <StackPanel
                    Grid.Row="1"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center">
                    <TextBlock
                        Width="300"
                        FontSize="32"
                        FontWeight="Bold"
                        TextWrapping="Wrap">
                        Quản lý vận hành rõ ràng, tập trung.
                    </TextBlock>
                    <TextBlock
                        Width="300"
                        Margin="10"
                        FontSize="12"
                        Foreground="#777"
                        TextWrapping="Wrap">
                        Không gian làm việc dành cho quản lý toàn chuỗi và nhân viên tại chi nhánh.
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Grid>
        <StackPanel
            Grid.Column="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Orientation="Vertical">
            <TextBlock
                Margin="10"
                FontSize="12"
                Foreground="#777">
                Đăng nhập hệ thống
            </TextBlock>
            <TextBlock
                Margin="10"
                FontSize="18"
                FontWeight="Bold">
                Chào mừng trở lại
            </TextBlock>
            <TextBlock
                Margin="10"
                FontSize="12"
                Foreground="#777">
                Nhập thông tin tài khoản của bạn.
            </TextBlock>
            <TextBlock
                Margin="10"
                FontSize="12"
                FontWeight="Bold">
                Tên đăng nhập
            </TextBlock>
            <TextBox
                x:Name="txt_username"
                Margin="10"
                FontSize="12" />
            <TextBlock
                Margin="10"
                FontSize="12"
                FontWeight="Bold">
                Mật khẩu
            </TextBlock>
            <PasswordBox
                x:Name="password"
                Margin="10"
                FontSize="12" />
            <Button
                x:Name="button_login"
                Margin="10"
                Background="black"
                Click="click_login"
                Foreground="white">
                Đăng nhập
            </Button>
        </StackPanel>
    </Grid>
</Window>
